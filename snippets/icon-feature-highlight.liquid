{%- comment -%}
  Renders a preset line-icon for the product feature highlight block.
  Usage: {% render 'icon-feature-highlight', icon: 'leaf' %}
{%- endcomment -%}
{%- case icon -%}
  {%- when 'perfume' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 2.5h4v3h-4z"></path><path d="M12 5.5V7"></path><rect x="5.5" y="7" width="13" height="14.5" rx="6.2"></rect><path d="M16.5 3.5h2.5M16.4 5.4l2.3 1.2M16.4 1.6l2.3-1.2"></path><path d="M7.2 14.1c1.7-1.6 3.2 1.3 4.8.2s3.2-1.8 4.8.2"></path></svg>
  {%- when 'ingredients' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="8.5" y="2" width="7" height="3.2" rx="1.6"></rect><path d="M10.2 5.2v4.1L5.4 18.8a1.6 1.6 0 0 0 1.4 2.4h10.4a1.6 1.6 0 0 0 1.4-2.4L13.8 9.3V5.2"></path><path d="M7.1 15.4c1.7-1.1 3.3.8 4.9.2s3.3-.5 4.9.7"></path><path d="M12.3 20.5c-3.1 0-4.8-2.1-4-5.2 3.1 0 4.8 2.1 4 5.2z"></path><path d="M8.9 15.9c1.8.9 3 2.5 3.4 4.6"></path></svg>
  {%- when 'badge' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"></circle><path d="M8.5 13.5 7 22l5-3 5 3-1.5-8.5"></path></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 3v6c0 5-3.4 8.7-8 11-4.6-2.3-8-6-8-11V5l8-3z"></path><path d="M9 12l2 2 4-4"></path></svg>
  {%- when 'drop' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2s7 7.5 7 12.5a7 7 0 0 1-14 0C5 9.5 12 2 12 2z"></path></svg>
  {%- when 'energy' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7l1-8z"></path></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7.5-4.6-10-9.3C0.3 8.4 2 4.5 6 4c2.2-0.3 4.2 0.9 6 3 1.8-2.1 3.8-3.3 6-3 4 0.5 5.7 4.4 4 7.7C19.5 16.4 12 21 12 21z"></path></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l3 6.2 6.8.9-5 4.7 1.3 6.7L12 17.8l-6.1 3.2 1.3-6.7-5-4.7 6.8-.9L12 2.5z"></path></svg>
  {%- when 'lock' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg>
  {%- when 'flame' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22c4.4 0 7-2.7 7-6.5C19 11 15 8.5 14.5 4c-1.8 2-3 4-3 6.5-1.6-1-2-2.8-2-4.5-2.6 1.8-4.5 5-4.5 8.2C5 19.3 7.6 22 12 22z"></path></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15c0-6 4-11 11-11 0 7-3 11-9 11H5z"></path><path d="M5 15c1 2.5 3 4 6 5"></path></svg>
{%- endcase -%}
