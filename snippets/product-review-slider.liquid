{%- comment -%}
  Review slider block. Params: rs_block (the review_slider block).
  Rendered inside the info column, or after the Description tabs when tabs sit outside it.
{%- endcomment -%}
{%- liquid
  assign bk_stts = rs_block.settings
  comment
    Swipe slider for review screenshots. Hidden when image 1 is empty,
    so connect the images to product metafields (File) and leave them
    blank here to show different reviews per product.
  endcomment
  assign rs_count = 0
  for i in (1..4)
    assign rs_key = 'image' | append: i
    if bk_stts[rs_key] != blank
      assign rs_count = rs_count | plus: 1
    endif
  endfor
  assign rs_class = ''
  if bk_stts.visibility == 'mobile'
    assign rs_class = ' is--mobile-only'
  elsif bk_stts.visibility == 'desktop'
    assign rs_class = ' is--desktop-only'
  endif
  if bk_stts.full_width
    assign rs_class = rs_class | append: ' is--full-width'
  endif
  if rs_count == 1
    assign rs_class = rs_class | append: ' is--single'
  endif
  assign rs_autoplay = 0
  if bk_stts.autoplay
    assign rs_autoplay = bk_stts.interval | default: 4
  endif
-%}
{%- if rs_count > 0 -%}
  {{ 'product-review-slider.css' | asset_url | stylesheet_tag }}
  <div class="t4s-pr-rslider{{ rs_class }}" data-review-slider data-autoplay="{{ rs_autoplay }}" style="--rs-max-w:{{ bk_stts.max_width | default: 600 }}px;--rs-radius:{{ bk_stts.radius | default: 0 }}px;--rs-space:{{ bk_stts.space | default: 20 }}px;--rs-heading-color:{{ bk_stts.heading_color | default: '#1a1a1a' }}" {{ rs_block.shopify_attributes }}>
    {%- if bk_stts.heading != blank -%}<p class="t4s-pr-rslider__heading">{{ bk_stts.heading }}</p>{%- endif -%}
    <div class="t4s-pr-rslider__wrap">
      <div class="t4s-pr-rslider__track" data-rs-track>
        {%- for i in (1..4) -%}
          {%- assign rs_key = 'image' | append: i -%}
          {%- assign rs_img = bk_stts[rs_key] -%}
          {%- if rs_img != blank -%}
            <div class="t4s-pr-rslider__slide">
              {{- rs_img | image_url: width: 1200 | image_tag: widths: '320, 480, 640, 800, 1000, 1200', sizes: '(max-width: 767px) 100vw, 600px', loading: 'lazy', alt: rs_img.alt | default: bk_stts.heading -}}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <button type="button" class="t4s-pr-rslider__btn t4s-pr-rslider__btn--prev" data-rs-prev aria-label="Previous"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <button type="button" class="t4s-pr-rslider__btn t4s-pr-rslider__btn--next" data-rs-next aria-label="Next"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
    <script>
      (function () {
        var root = document.currentScript && document.currentScript.parentNode;
        if (!root || root.getAttribute('data-rs-ready')) return;
        root.setAttribute('data-rs-ready', '1');
        var track = root.querySelector('[data-rs-track]');
        var slides = track.children;
        if (slides.length < 2) return;
        var timer = null;
        var visible = false;
        var held = false;
        var secs = parseFloat(root.getAttribute('data-autoplay')) || 0;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
        function index() { return Math.round(track.scrollLeft / track.clientWidth); }
        function go(i) {
          var n = slides.length;
          track.scrollTo({ left: ((i % n) + n) % n * track.clientWidth });
        }
        function stop() { if (timer) { clearInterval(timer); timer = null; } }
        function start() {
          stop();
          if (!secs || reduce || !visible || held) return;
          timer = setInterval(function () { go(index() + 1); }, secs * 1000);
        }
  
        root.querySelector('[data-rs-prev]').addEventListener('click', function () { go(index() - 1); start(); });
        root.querySelector('[data-rs-next]').addEventListener('click', function () { go(index() + 1); start(); });
        track.addEventListener('touchstart', function () { held = true; stop(); }, { passive: true });
        track.addEventListener('touchend', function () { held = false; start(); }, { passive: true });
        track.addEventListener('touchcancel', function () { held = false; start(); }, { passive: true });
  
        if ('IntersectionObserver' in window) {
          new IntersectionObserver(function (entries) {
            visible = entries[0].isIntersecting;
            start();
          }, { threshold: 0.4 }).observe(root);
        } else {
          visible = true;
          start();
        }
      })();
    </script>
  </div>
{%- endif -%}
