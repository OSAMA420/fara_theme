{%- comment -%}
  Renders one preset icon for a product badge pill.
  Usage: {% render 'icon-product-badge', icon: 'instagram', uid: badge_uid %}

  Brand and flag icons carry their own colours. The rest use currentColor so
  they follow the badge's text colour.
  uid keeps the flag's clipPath id unique when several badges are on a page.
{%- endcomment -%}
{%- case icon -%}
  {%- when 'instagram' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="#E1306C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="1.15" fill="#E1306C" stroke="none"></circle></svg>
  {%- when 'facebook' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" fill="#1877F2"></circle><path d="M13.7 20v-7.1h2.4l.36-2.77H13.7V8.35c0-.8.22-1.35 1.38-1.35h1.47V4.52A19.7 19.7 0 0 0 14.4 4.4c-2.13 0-3.58 1.3-3.58 3.68v2.05H8.4v2.77h2.42V20h2.88z" fill="#fff"></path></svg>
  {%- when 'tiktok' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" fill="#010101"></circle><path d="M15.9 8.4a3.3 3.3 0 0 1-2-1.6h-1.7v7.4a1.6 1.6 0 1 1-1.2-1.55V10.9a3.4 3.4 0 1 0 3.1 3.38V10.5c.55.35 1.2.56 1.9.6V9.4c-.04 0-.07-.01-.1-.01z" fill="#fff"></path></svg>
  {%- when 'france' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><defs><clipPath id="fbadge-fr-{{ uid }}"><circle cx="12" cy="12" r="9.5"></circle></clipPath></defs><g clip-path="url(#fbadge-fr-{{ uid }})"><rect x="2.5" y="2.5" width="6.34" height="19" fill="#002395"></rect><rect x="8.84" y="2.5" width="6.32" height="19" fill="#ffffff"></rect><rect x="15.16" y="2.5" width="6.34" height="19" fill="#ED2939"></rect></g><circle cx="12" cy="12" r="9.5" fill="none" stroke="#d8d8d8"></circle></svg>
  {%- when 'globe' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"></circle><path d="M2.5 12h19"></path><path d="M12 2.5c2.4 2.6 3.7 5.9 3.7 9.5S14.4 18.9 12 21.5C9.6 18.9 8.3 15.6 8.3 12S9.6 5.1 12 2.5z"></path></svg>
  {%- when 'award' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"></circle><path d="M8.7 14.3 7.4 22l4.6-2.7 4.6 2.7-1.3-7.7"></path></svg>
  {%- when 'verified' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l2.4 1.9 3-.3 1 2.9 2.6 1.6-1.1 2.9 1.1 2.9-2.6 1.6-1 2.9-3-.3-2.4 1.9-2.4-1.9-3 .3-1-2.9L3 15.9 4.1 13 3 10.1l2.6-1.6 1-2.9 3 .3z"></path><path d="M9 12l2.1 2.1L15.4 9.8"></path></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l3 6.2 6.8.9-5 4.7 1.3 6.7L12 17.8l-6.1 3.2 1.3-6.7-5-4.7 6.8-.9L12 2.5z"></path></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 15c0-6 4-11 11-11 0 7-3 11-9 11H5z"></path><path d="M5 15c1 2.5 3 4 6 5"></path></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9.5"></circle><path d="M8.6 12.2l2.4 2.4 4.4-5"></path></svg>
{%- endcase -%}
