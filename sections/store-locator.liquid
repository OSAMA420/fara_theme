{% comment %} FARA Store Locator - List + Expandable Map style {% endcomment %}
<section class="fara-store-locator">
  <div class="page-width">

    <div class="locator-heading">
      <span class="small-title">FA'RA LONDON</span>
      <h1>Find a Store Near You</h1>
      <p>Visit any of our locations across Pakistan.</p>
    </div>

    <div class="locator-search">
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <input type="text" id="storeSearch" placeholder="">
      </div>
    </div>

    <div class="city-tabs" id="cityTabs"></div>

    <div class="locator-info">
      <span id="storeCount"></span>
    </div>

    <div id="storeList" class="store-list"></div>

  </div>
</section>

<style>
  .fara-store-locator {
    padding: 40px 0 60px;
  }

  .page-width {
    max-width: 1300px;
    margin: auto;
    padding: 0 20px;
  }

  .locator-heading {
    text-align: center;
    margin-bottom: 30px;
  }

  .small-title {
    display: block;
    letter-spacing: 3px;
    font-size: 13px;
    color: #777;
  }

  .locator-heading h1 {
    font-size: 34px;
    margin: 8px 0;
  }

  .locator-heading p {
    color: #666;
    font-size: 15px;
  }

  .locator-search {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
  }

  .search-box {
    position: relative;
    width: 100%;
    max-width: 420px;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 15px;
    opacity: .5;
    pointer-events: none;
  }

  #storeSearch {
    width: 100%;
    height: 48px;
    padding: 0 16px 0 46px;
    border: 1px solid #ddd;
    border-radius: 30px;
    font-size: 14px;
  }

  .city-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-bottom: 20px;
  }

  .city-tab {
    border: 1px solid #ddd;
    background: #fff;
    color: #333;
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 13px;
    cursor: pointer;
    transition: .2s;
    white-space: nowrap;
  }

  .city-tab:hover {
    border-color: #111;
  }

  .city-tab.active {
    background: #111;
    color: #fff;
    border-color: #111;
  }

  .locator-info {
    text-align: center;
    font-size: 14px;
    color: #666;
    margin-bottom: 20px;
  }

  .locator-info span {
    font-weight: 600;
    color: #111;
  }

  /* ---------- Store list rows ---------- */
  .store-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: start;
  }

  @media (max-width: 991px) {
    .store-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .store-list {
      grid-template-columns: 1fr;
    }
  }

  .store-row {
    border: 1px solid #ececec;
    border-radius: 10px;
    padding: 20px;
    opacity: 0;
    transform: translateY(15px);
    animation: faraFade .4s ease forwards;
    transition: border-color .3s ease, box-shadow .3s ease, transform .3s ease;
  }

  .store-row:hover {
    border-color: #000;
    box-shadow: 0 18px 40px rgba(0, 0, 0, .10);
    transform: translateY(-6px);
  }

  @keyframes faraFade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .store-row {
    display: flex;
    flex-direction: column;
  }

  .store-row-top {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .store-city-tag {
    display: inline-block;
    background: #111;
    color: #fff;
    padding: 4px 12px;
    border-radius: 30px;
    font-size: 10px;
    letter-spacing: 1px;
    font-weight: 600;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .store-row h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 6px;
    color: #111;
  }

  .store-address {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
  }

  .store-row-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
  }

  .store-phone-link {
    font-size: 13px;
    color: #111;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  .map-toggle-btn {
    border: 1px solid #111;
    background: #fff;
    color: #111;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: .2s;
    white-space: nowrap;
  }

  .map-toggle-btn:hover,
  .map-toggle-btn.is-open {
    background: #111;
    color: #fff;
  }

  .store-map-wrap {
    max-height: 0;
    overflow: hidden;
    transition: max-height .4s ease;
    margin-top: 0;
  }

  .store-map-wrap.is-open {
    max-height: 320px;
    margin-top: 16px;
  }

  .store-map-wrap iframe {
    width: 100%;
    height: 280px;
    border: 0;
    border-radius: 8px;
    display: block;
  }

  .no-store {
    padding: 60px 20px;
    text-align: center;
    border: 1px solid #eee;
    border-radius: 12px;
    background: #fafafa;
  }

  .no-store h3 {
    margin-bottom: 8px;
    font-size: 24px;
  }

  .no-store p {
    color: #777;
  }


</style>

