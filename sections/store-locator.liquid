    { city: "Jhang", name: "Makeup City Gts Mall Jhang", address: "Jhang - Gts Mall, Session Chowk Saddar.", phone: "", mapQuery: "Makeup%20City%20Gts%20Mall%20Jhang%2C%20Jhang%20-%20Gts%20Mall%2C%20Session%20Chowk%20Saddar." }
  ];

  const storeList  = document.getElementById("storeList");
  const cityTabs   = document.getElementById("cityTabs");
  const search     = document.getElementById("storeSearch");
  const storeCount = document.getElementById("storeCount");

  let activeCity = "all";

  function buildCityTabs() {
    const counts = {};
    stores.forEach(s => counts[s.city] = (counts[s.city] || 0) + 1);
    const cities = Object.keys(counts).sort();

    let html = `<button class="city-tab active" data-city="all">All ${stores.length}</button>`;
    cities.forEach(c => {
      html += `<button class="city-tab" data-city="${c}">${c} ${counts[c]}</button>`;
    });
    cityTabs.innerHTML = html;

    cityTabs.querySelectorAll(".city-tab").forEach(btn => {
      btn.addEventListener("click", () => {
        cityTabs.querySelectorAll(".city-tab").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        activeCity = btn.getAttribute("data-city");
        filterStores();
      });
    });
  }

  function renderStores(list) {
    storeList.innerHTML = "";

    if (!list.length) {
      storeList.innerHTML = `
        <div class="no-store">
          <h3>No Stores Found</h3>
          <p>Try searching with another city or keyword.</p>
        </div>
      `;
      storeCount.textContent = "0 stores found";
      return;
    }

    list.forEach((store, i) => {
      const row = document.createElement("div");
      row.className = "store-row";
      row.style.animationDelay = (i * 30) + "ms";

      row.innerHTML = `
        <div class="store-row-top">
          <div>
            <div class="store-city-tag">${store.city}</div>
            <h3>${store.name}</h3>
            <p class="store-address">📍 ${store.address}</p>
          </div>
          <div class="store-row-actions">
            ${store.phone ? `<a class="store-phone-link" href="tel:${store.phone.replace(/-/g, '')}">${store.phone}</a>` : ""}
            <button class="map-toggle-btn" type="button">View Map</button>
          </div>
        </div>
        <div class="store-map-wrap">
          <iframe loading="lazy" data-src="https://maps.google.com/maps?q=${store.mapQuery}&output=embed"></iframe>
        </div>
      `;

      const btn = row.querySelector(".map-toggle-btn");
      const mapWrap = row.querySelector(".store-map-wrap");
      const iframe = row.querySelector("iframe");

      btn.addEventListener("click", () => {
        const isOpen = mapWrap.classList.contains("is-open");

        if (isOpen) {
          mapWrap.classList.remove("is-open");
          btn.classList.remove("is-open");
          btn.textContent = "View Map";
        } else {
          if (!iframe.src) {
            iframe.src = iframe.getAttribute("data-src");
          }
          mapWrap.classList.add("is-open");
          btn.classList.add("is-open");
          btn.textContent = "Close Map";
        }
      });

      storeList.appendChild(row);
    });

    storeCount.textContent = `${list.length} store${list.length > 1 ? "s" : ""} found`;
  }

  function filterStores() {
    const keyword = search.value.toLowerCase();

    const filtered = stores.filter(s => {
      const matchesCity = activeCity === "all" || s.city === activeCity;
      const matchesKeyword = [s.city, s.name, s.address]
        .join(" ")
        .toLowerCase()
        .includes(keyword);
      return matchesCity && matchesKeyword;
    });

    renderStores(filtered);
  }

  search.addEventListener("input", filterStores);

  // ---------- Animated typewriter placeholder ----------
  function typewriterPlaceholder(el, text, opts) {
    opts = opts || {};
    var typeSpeed   = opts.typeSpeed   || 80;
    var deleteSpeed = opts.deleteSpeed || 40;
    var holdTime    = opts.holdTime    || 1500;
    var restartGap  = opts.restartGap  || 500;

    var i = 0;
    var deleting = false;

    function tick() {
      // stop cycling while user is actively typing in the field
      if (document.activeElement === el && el.value.length > 0) {
        setTimeout(tick, 500);
        return;
      }

      if (!deleting) {
        i++;
        el.placeholder = text.slice(0, i);
        if (i === text.length) {
          deleting = true;
          setTimeout(tick, holdTime);
          return;
        }
        setTimeout(tick, typeSpeed);
      } else {
        i--;
        el.placeholder = text.slice(0, i);
        if (i === 0) {
          deleting = false;
          setTimeout(tick, restartGap);
          return;
        }
        setTimeout(tick, deleteSpeed);
      }
    }

    el.placeholder = "";
    tick();
  }

  function startTypewriter() {
    typewriterPlaceholder(search, "Search city or store...");
  }

  if (document.readyState === "complete") {
    startTypewriter();
  } else {
    window.addEventListener("load", startTypewriter);
  }

  buildCityTabs();
  renderStores(stores);
</script>

